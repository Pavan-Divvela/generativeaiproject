# ── Flask ──────────────────────────────────────────────────────────────────────
PORT=5000
DEBUG=True
SECRET_KEY=change-me-in-production

# ── Gemini AI ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── ChromaDB RAG ───────────────────────────────────────────────────────────────
# Path to the persistent ChromaDB storage (relative to project root or absolute)
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION=aadhaar_pan_passport

# Path to raw PDF folder (contains aadhaar/, pan/, passport/ subdirs)
RAW_DATA_DIR=data/raw

# Path to source manifest JSON (maps PDF filename → official government URL)
SOURCE_MANIFEST=data/source_manifest.json

# ── Chunking & Retrieval ───────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
MAX_QUESTION_LEN=1000
